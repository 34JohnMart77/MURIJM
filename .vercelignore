# Keep the Python function bundle small and free of local-only files.

# Local virtualenv / caches must never be uploaded
muri/backend/venv/
muri/backend/__pycache__/
**/__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/

# Built by the frontend service at deploy time
frontend/node_modules/
frontend/dist/
frontend/android/
frontend/.env.android

# Tests never ship to production
tests/

# Local secrets must never ship: the Vercel CLI does NOT apply .gitignore,
# so without this line a `vercel` CLI deploy would upload muri/backend/.env
# (its localhost DATABASE_URL would then shadow your dashboard settings).
**/.env

# Repo extras not needed at runtime
.vscode/
MURI INTRO.mp4
Muri2026.jpg
README.md
