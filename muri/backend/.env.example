# Copy to .env and fill in secrets. Never commit the real .env.
GEMINI_API_KEY=your_gemini_api_key_here
MURI_MODEL=gemini-3.8-flash
# MURI_MODELS=gemini-3.8-flash,gemini-3.1-pro-preview
# MURI_DISCOVER_MODELS=false
# MURI_CHAT_RATE_LIMIT=20
# MURI_CHAT_RATE_WINDOW=60
# MURI_DAILY_MESSAGE_CAP=200
# MURI_MAX_MESSAGE_CHARS=8000
# MURI_MAX_ATTACHMENT_TEXT_CHARS=20000
# MURI_AUTH_RATE_LIMIT=10
# MURI_AUTH_RATE_WINDOW=300
# Vercel: this file is git-ignored and never uploaded to the deployment.
# Set every variable below (DATABASE_URL, GEMINI_API_KEY, MURI_SECRET_KEY,
# MURI_BASE_URL, MURI_COOKIE_SECURE) in the Vercel project's Environment
# Variables instead (Settings -> Environment Variables, Production + Preview).
# Local development only. Set the hosted database URL in Vercel's
# DATABASE_URL environment variable when deploying.
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/muri?charset=utf8mb4

MURI_HOST=0.0.0.0
MURI_PORT=8000
MURI_SECRET_KEY=change-me-to-a-long-random-string
MURI_BASE_URL=http://localhost:8000
MURI_COOKIE_SECURE=false
# MURI_COOKIE_SAMESITE=lax
# MURI_CORS_ORIGINS=https://your-frontend.example.com
# Optional OAuth: configure the provider's authorized callback URL as
# http://localhost:8000/api/auth/oauth/google/callback or
# http://localhost:8000/api/auth/oauth/facebook/callback.
# On Render, RENDER_EXTERNAL_URL supplies the public base URL automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Administrator email allowed to use the Murillon admin dashboard.
MURI_ADMIN_EMAIL=
# Required for the admin email/password login form. Use a unique random secret
# with at least 16 characters; keep it private and configure it on the server.
MURI_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
